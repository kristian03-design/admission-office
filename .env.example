APP_NAME="BTECH Admission Office"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admission-office-kristian-hernandez.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

ADMIN_EMAIL=btechadmissionoffice@gmail.com
# Set only for first production seed, then remove.
ADMIN_INITIAL_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

CACHE_STORE=database
PUBLIC_CACHE_TTL=600
PUBLIC_HTTP_CACHE_TTL=300
QUEUE_CONNECTION=database
FILESYSTEM_DISK=supabase

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Server-side only. Never prefix with VITE_ and never expose in browser code.
SUPABASE_S3_KEY=
SUPABASE_S3_SECRET=
SUPABASE_S3_REGION=ap-northeast-1
SUPABASE_S3_BUCKET=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_URL=

# Frontend-safe only if you actually use Supabase client-side with RLS enabled.
# Do not put service-role keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=admission-office-kristian-hernandez.vercel.app
CORS_ALLOWED_ORIGINS=https://admission-office-kristian-hernandez.vercel.app
SANCTUM_TOKEN_PREFIX=btech_pat_
SANCTUM_EXPIRATION=120

VERCEL=1
APP_STORAGE_PATH=/tmp/storage
