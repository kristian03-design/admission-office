# ============================================================
# ADMISSION OFFICE BACKEND - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

APP_NAME="Admission Office Backend"
APP_VERSION="1.0.0"
APP_ENV=local          # local | staging | production
APP_DEBUG=true
APP_URL=http://localhost:8000

# ── Database ─────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=admission_db
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# ── JWT ──────────────────────────────────────────────────────
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_ACCESS_EXPIRY=900          # 15 minutes in seconds
JWT_REFRESH_EXPIRY=604800      # 7 days in seconds
JWT_ALGORITHM=HS256

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# ── File Uploads ─────────────────────────────────────────────
UPLOAD_MAX_SIZE=5242880        # 5 MB in bytes
UPLOAD_ALLOWED_TYPES=pdf,jpg,jpeg,png
UPLOAD_PATH=storage/uploads

# ── Email (SMTP) ─────────────────────────────────────────────
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@admission.edu
MAIL_FROM_NAME="Admission Office"

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug                # debug | info | warning | error
LOG_PATH=storage/logs/app.log
